<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <title>Redaction Demo</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["_content/AiDocumentRedactor.App.Ui/ui.css"]" />
        <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes SessionId="@(HttpContext?.Items["rd_session"] as string)" @rendermode="InteractiveServer" />

        <script src="@Assets["_content/AiDocumentRedactor.App.Ui/redactorUi.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    /// <summary>The request, used to pass this browser's session id to the interactive part of the page.</summary>
    [CascadingParameter] HttpContext? HttpContext { get; set; }
}
