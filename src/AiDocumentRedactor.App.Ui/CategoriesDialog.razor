@* Categories dialog: switch each kind of sensitive data on or off, choose redact or flag, and turn pronouns on or off. The changes belong to
   this browser's session only and are used by the next Redact; the config file is never written. It also holds the switch for the
   second-opinion model (GLiNER). *@
@inject RedactionSession S

<div class="overlay" @onclick="Close">
    <div class="dialog" role="dialog" aria-modal="true" aria-label="Categories" @onclick:stopPropagation>
        <div class="dialog-head">
            <h2>Categories</h2>
            <button class="btn icon" @onclick="Close" aria-label="Close">✕</button>
        </div>
        <p class="dialog-note">
            Choose what the model looks for. <strong>Redact</strong> removes what is found; <strong>Flag</strong> lists it for review and leaves it in the text.
            Changes apply to the next <em>Redact</em> and last for this session only. They are not saved to <code>redactor.config.json</code>.
        </p>
        <table class="models">
            <thead><tr><th>On</th><th>Category</th><th>What it covers</th><th>When found</th></tr></thead>
            <tbody>
            @foreach (var c in S.Categories)
            {
                <tr class="@(c.Enabled ? "" : "unavail")">
                    <td class="center">
                        <label class="switch" title="@(c.Enabled ? "On: the model looks for this" : "Off: the model is not asked about this")">
                            <input type="checkbox" role="switch" aria-label="@c.Type" checked="@c.Enabled" @onchange="e => S.SetCategoryEnabled(c.Type, (bool)(e.Value ?? false))" />
                            <span class="slider"></span>
                        </label>
                    </td>
                    <td><span class="chip type t-@c.Type">@c.Type</span></td>
                    <td>@c.Description
                        @if (c.Type == "GENDER")
                        {
                            <div class="sub"><label><input type="checkbox" checked="@c.RedactPronouns" disabled="@(!c.Enabled)" @onchange="e => S.SetPronouns((bool)(e.Value ?? false))" /> Also redact pronouns (he, him, his, she, her, hers)</label></div>
                        }
                    </td>
                    <td>
                        <select aria-label="Mode for @c.Type" disabled="@(!c.Enabled)" @onchange='e => S.SetCategoryMode(c.Type, e.Value?.ToString() ?? "redact")'>
                            <option value="redact" selected="@(c.Mode != "flag")">Redact</option>
                            <option value="flag" selected="@(c.Mode == "flag")">Flag only</option>
                        </select>
                    </td>
                </tr>
            }
            </tbody>
        </table>
        <div class="second-opinion @(S.SecondOpinionAvailable ? "" : "unavail")">
            <label class="switch" title="@(S.SecondOpinionAvailable ? "Also ask a small second model, and compare" : "The GLiNER model files are not installed")">
                <input type="checkbox" role="switch" aria-label="Second opinion (GLiNER)" checked="@S.SecondOpinionOn" disabled="@(!S.SecondOpinionAvailable)" @onchange="e => S.SetSecondOpinion((bool)(e.Value ?? false))" />
                <span class="slider"></span>
            </label>
            <div class="so-text">
                <strong>Second opinion (GLiNER)</strong>
                <p>A small second model reads the document too. Where it agrees with the main model, the edit shows <em>AI + GLiNER</em>. Where <strong>only</strong> GLiNER finds something,
                    it is flagged for you to decide, with its reason, and left in the text unless you choose to redact it. It runs on this machine and adds about a tenth of a second.</p>
                @if (!S.SecondOpinionAvailable)
                {
                    <p class="so-missing">The model files were not found in <code>@S.SecondOpinionFolder</code>. See <em>How to run the Web App</em> to install them.</p>
                }
                else
                {
                    <label class="so-solo">Something only GLiNER finds:
                        <select aria-label="What to do with something only GLiNER finds" disabled="@(!S.SecondOpinionOn)" @onchange='e => S.SetSecondOpinionSoloAction(e.Value?.ToString() ?? "flag")'>
                            <option value="flag" selected="@(S.SecondOpinionSoloAction == "flag")">Flag for review (leave in the text)</option>
                            <option value="redact" selected="@(S.SecondOpinionSoloAction == "redact")">Redact</option>
                        </select>
                    </label>
                }
            </div>
        </div>
        <div class="cleanup">
            <strong>Clean-up rules</strong>
            <p>Fixed checks that run after the model and take away its predictable mistakes. Each can be switched on its own. They only remove redactions the model made (never the fixed rules, your lists or your own edits), and whatever they leave out is listed with the edits so you can check it and redact it after all.</p>
            @foreach (var r in S.CleanUpRules)
            {
                <div class="cu-row">
                    <label class="switch" title="@r.Description">
                        <input type="checkbox" role="switch" aria-label="@r.Name" checked="@r.On" @onchange="e => S.SetCleanUp(r.Key, (bool)(e.Value ?? false))" />
                        <span class="slider"></span>
                    </label>
                    <div><strong>@r.Name</strong><div class="sub">@r.Description</div></div>
                </div>
            }
        </div>
        <div class="dialog-foot">
            <button class="btn" disabled="@(!S.CategoriesChanged)" title="Put every category and the second opinion back to the config file's settings" @onclick="S.ResetCategories">↺ Reset to config file</button>
            <button class="btn primary" @onclick="Close">Done</button>
        </div>
    </div>
</div>

@code {
    /// <summary>Called when the dialog should close.</summary>
    [Parameter] public EventCallback OnClose { get; set; }
    /// <summary>Closes the dialog.</summary>
    Task Close() => OnClose.InvokeAsync();
}
